# Copy to `.env` for local development. Never commit real secrets.
#
# Only EXPO_PUBLIC_* keys are exposed to the mobile client.
# Phase 1 needs only EXPO_PUBLIC_APP_ENV. Later phases add their own
# client-safe keys; server-only secrets must never live in this app.

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Phase 12 — CSV statement import.
# Client-safe. Gates the "Import a bank CSV" entry points on "true". The parser
# works on any bank whose column layout we recognise; it does not detect which
# bank a file came from, and the user supplies the account name.
EXPO_PUBLIC_FEATURE_CSV_IMPORT=true

# Phase 11 — real bank connections (Mono).
# Client-safe. Gate the "Connect a real bank" flow on "true".
EXPO_PUBLIC_FEATURE_MONO=false
# Mono Connect widget public key. Publishable identifier, NOT the secret key.
EXPO_PUBLIC_MONO_PUBLIC_KEY=

# Server-only. Never commit a real value and never put these in the client.
#   MONO_SECRET_KEY       -> set as a Supabase Edge Function secret
#   MONO_WEBHOOK_SECRET   -> set as a Supabase Edge Function secret; copy it
#                            from the webhook config in the Mono dashboard
#   FEATURE_MONO          -> Edge Function secret gating the server-side Mono
#                            paths. Kept separate from EXPO_PUBLIC_FEATURE_MONO
#                            on purpose, so neither side can be enabled alone.

# Agent-as-user web passes (scripts/create-test-user.cjs, scripts/mono-web-pass.cjs).
# Supabase rejects example.com and rate-limits signup emails, so passes create a
# pre-confirmed user via the admin API and sign in instead.
PASS_EMAIL=
PASS_PASSWORD=
